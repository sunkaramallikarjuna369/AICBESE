# CBSE Learning Platform - Low-Cost Edition
# Environment Variables Configuration

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Options: mock (free), replicate (low-cost), vertex (higher cost)
# Default: mock (no API calls, returns pre-defined responses)
AI_PROVIDER=mock

# Replicate Configuration (recommended for low-budget production)
# Get your API token from https://replicate.com/account/api-tokens
# Cost: ~$0.05 per million tokens with Llama 3.1 8B
REPLICATE_API_TOKEN=
REPLICATE_MODEL=meta/meta-llama-3.1-8b-instruct

# Vertex AI Configuration (higher cost, requires GCP project)
# Only use if you have GCP credits or higher budget
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Download from Firebase Console > Project Settings > Service Accounts
# Free tier: 50K reads/day, 20K writes/day, 1GB storage
FIREBASE_CREDENTIALS_PATH=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_ENV=development
DEBUG=true

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# =============================================================================
# GCP CONFIGURATION (Optional)
# =============================================================================
GCP_PROJECT_ID=
GCP_REGION=asia-south1

# =============================================================================
# OPTIONAL SERVICES (Skip for low-budget deployments)
# =============================================================================
# Redis for caching (skip for low-budget, use in-memory instead)
REDIS_URL=

# Pub/Sub for async processing (skip for low-budget)
PUBSUB_PROJECT=
